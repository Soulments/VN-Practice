{
  "id": "sample",
  "commands": [
    { "type": "set", "name": "kindness", "value": "=0" },
    { "type": "bg", "name": "classroom", "duration": 0.8 },
    { "type": "bgm", "name": "daily", "duration": 1.0 },
    { "type": "show", "name": "jihu_normal", "position": "left", "duration": 0.4 },
    { "type": "say", "speaker": "지후", "text": "안녕하세요! 비주얼 노벨 테스트입니다." },
    { "type": "sfx", "name": "ding" },
    { "type": "show", "name": "mina_normal", "position": "right", "duration": 0.4 },
    { "type": "say", "speaker": "미나", "text": "처음 뵙겠습니다. 저는 미나예요." },
    { "type": "say", "speaker": "지후", "text": "클릭하면 다음 줄로 넘어갑니다." },
    { "type": "bg", "name": "hallway", "duration": 0.8 },
    { "type": "show", "name": "jihu_smile", "position": "left", "duration": 0.4 },
    { "type": "say", "speaker": "지후", "text": "자리를 복도로 옮겨 볼까요?" },
    {
      "type": "choice",
      "options": [
        { "text": "인사를 받아준다", "target": "kind", "set": "kindness+1" },
        { "text": "무시한다", "target": "cold" }
      ]
    },
    { "type": "label", "name": "kind" },
    { "type": "sfx", "name": "pop" },
    { "type": "say", "speaker": "지후", "text": "고마워요!" },
    { "type": "jump", "target": "rooftop" },
    { "type": "label", "name": "cold" },
    { "type": "say", "speaker": "지후", "text": "...그렇군요." },

    { "type": "label", "name": "rooftop" },
    { "type": "hide", "name": "mina_normal", "duration": 0.4 },
    { "type": "bg", "name": "rooftop", "duration": 0.8 },
    { "type": "bgm", "name": "evening", "duration": 1.5 },
    { "type": "say", "speaker": "", "text": "옥상에는 노을이 지고 있다." },
    { "type": "say", "speaker": "지후", "text": "저기, 하고 싶은 말이 있는데요." },
    {
      "type": "choice",
      "options": [
        { "text": "솔직하게 마음을 전한다", "target": "honest", "set": "kindness+1" },
        { "text": "웃으며 넘긴다", "target": "evade" }
      ]
    },
    { "type": "label", "name": "honest" },
    { "type": "say", "speaker": "지후", "text": "...사실 계속 말하고 싶었어요." },
    { "type": "jump", "target": "judge" },
    { "type": "label", "name": "evade" },
    { "type": "say", "speaker": "지후", "text": "그, 그렇죠. 별일 아니에요." },

    { "type": "label", "name": "judge" },
    { "type": "if", "name": "kindness", "value": ">=2", "target": "ending_good" },
    { "type": "jump", "target": "ending_normal" },

    { "type": "label", "name": "ending_good" },
    { "type": "say", "speaker": "", "text": "서로의 마음이 닿았다." },
    { "type": "hide", "position": "left", "duration": 0.4 },
    { "type": "bgm", "name": "stop", "duration": 1.0 },
    { "type": "end", "name": "good" },

    { "type": "label", "name": "ending_normal" },
    { "type": "say", "speaker": "", "text": "아무 일도 없었던 것처럼 하루가 저물었다." },
    { "type": "hide", "position": "left", "duration": 0.4 },
    { "type": "bgm", "name": "stop", "duration": 1.0 },
    { "type": "end", "name": "normal" }
  ]
}
